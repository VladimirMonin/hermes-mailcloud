{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-mailcloud/schemas/batch-plan.schema.json",
  "title": "Hermes MailCloud Batch Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operations"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "description": {"type": "string", "minLength": 1},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overwrite": {"type": "string", "enum": ["never", "always", "if-newer"], "default": "never"},
        "continue_on_error": {"type": "boolean", "default": false}
      }
    },
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "$defs": {
    "localPath": {"type": "string", "minLength": 1},
    "remotePath": {"type": "string", "pattern": "^/", "minLength": 2},
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/ls"},
        {"$ref": "#/$defs/stat"},
        {"$ref": "#/$defs/mkdir"},
        {"$ref": "#/$defs/upload"},
        {"$ref": "#/$defs/download"},
        {"$ref": "#/$defs/mv"},
        {"$ref": "#/$defs/cp"},
        {"$ref": "#/$defs/rm"},
        {"$ref": "#/$defs/publish"},
        {"$ref": "#/$defs/link"}
      ]
    },
    "ls": {"type": "object", "additionalProperties": false, "required": ["op", "remote_path"], "properties": {"op": {"const": "ls"}, "remote_path": {"$ref": "#/$defs/remotePath"}, "recursive": {"type": "boolean"}}},
    "stat": {"type": "object", "additionalProperties": false, "required": ["op", "remote_path"], "properties": {"op": {"const": "stat"}, "remote_path": {"$ref": "#/$defs/remotePath"}}},
    "mkdir": {"type": "object", "additionalProperties": false, "required": ["op", "remote_path"], "properties": {"op": {"const": "mkdir"}, "remote_path": {"$ref": "#/$defs/remotePath"}, "parents": {"type": "boolean"}, "exist_ok": {"type": "boolean"}}},
    "upload": {"type": "object", "additionalProperties": false, "required": ["op", "local_path", "remote_path"], "properties": {"op": {"const": "upload"}, "local_path": {"$ref": "#/$defs/localPath"}, "remote_path": {"$ref": "#/$defs/remotePath"}, "overwrite": {"type": "string", "enum": ["never", "always", "if-newer"]}}},
    "download": {"type": "object", "additionalProperties": false, "required": ["op", "remote_path", "local_path"], "properties": {"op": {"const": "download"}, "remote_path": {"$ref": "#/$defs/remotePath"}, "local_path": {"$ref": "#/$defs/localPath"}, "overwrite": {"type": "string", "enum": ["never", "always", "if-newer"]}}},
    "mv": {"type": "object", "additionalProperties": false, "required": ["op", "src_remote_path", "dst_remote_path"], "properties": {"op": {"const": "mv"}, "src_remote_path": {"$ref": "#/$defs/remotePath"}, "dst_remote_path": {"$ref": "#/$defs/remotePath"}}},
    "cp": {"type": "object", "additionalProperties": false, "required": ["op", "src_remote_path", "dst_remote_path"], "properties": {"op": {"const": "cp"}, "src_remote_path": {"$ref": "#/$defs/remotePath"}, "dst_remote_path": {"$ref": "#/$defs/remotePath"}}},
    "rm": {"type": "object", "additionalProperties": false, "required": ["op", "remote_path"], "properties": {"op": {"const": "rm"}, "remote_path": {"$ref": "#/$defs/remotePath"}, "recursive": {"type": "boolean"}}},
    "publish": {"type": "object", "additionalProperties": false, "required": ["op", "local_path", "remote_path"], "properties": {"op": {"const": "publish"}, "local_path": {"$ref": "#/$defs/localPath"}, "remote_path": {"$ref": "#/$defs/remotePath"}, "overwrite": {"type": "string", "enum": ["never", "always", "if-newer"]}}},
    "link": {"type": "object", "additionalProperties": false, "required": ["op", "remote_path"], "properties": {"op": {"const": "link"}, "remote_path": {"$ref": "#/$defs/remotePath"}}}
  },
  "examples": [
    {
      "version": 1,
      "defaults": {"overwrite": "never", "continue_on_error": false},
      "operations": [
        {"op": "mkdir", "remote_path": "/Hermes/public/reports", "parents": true},
        {"op": "publish", "local_path": "./report.pdf", "remote_path": "/Hermes/public/reports/report.pdf"}
      ]
    }
  ]
}