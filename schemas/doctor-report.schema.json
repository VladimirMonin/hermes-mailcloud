{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hermes-mailcloud/schemas/doctor-report.schema.json",
  "title": "Hermes MailCloud Doctor Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ok",
    "operation",
    "result"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "operation": {
      "type": "string",
      "const": "doctor"
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "remote": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "capabilities"
      ],
      "properties": {
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rclone_installed": {
              "type": "boolean"
            },
            "rclone_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "remote_exists": {
              "type": "boolean"
            },
            "cloud_access": {
              "type": "boolean"
            },
            "upload": {
              "type": "boolean"
            },
            "download": {
              "type": "boolean"
            },
            "publish": {
              "type": "boolean"
            },
            "public_url_probe": {
              "type": "boolean"
            },
            "unlink": {
              "type": "boolean"
            },
            "cleanup": {
              "type": "boolean"
            }
          }
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file_ops": {
              "type": "string",
              "enum": [
                "unknown",
                "supported",
                "unsupported",
                "partial"
              ]
            },
            "public_link_create": {
              "type": "string",
              "enum": [
                "unknown",
                "supported",
                "unsupported",
                "partial"
              ]
            },
            "public_link_unlink": {
              "type": "string",
              "enum": [
                "unknown",
                "supported",
                "unsupported",
                "partial"
              ]
            },
            "public_link_expire": {
              "type": "string",
              "enum": [
                "unknown",
                "supported",
                "unsupported",
                "partial"
              ]
            },
            "direct_download_url": {
              "type": "string",
              "enum": [
                "unknown",
                "supported",
                "unsupported",
                "partial"
              ]
            }
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "examples": [
    {
      "ok": true,
      "operation": "doctor",
      "profile": "default",
      "remote": "mailru:",
      "result": {
        "checks": {
          "rclone_installed": true,
          "rclone_version": "1.74.3",
          "remote_exists": true,
          "cloud_access": true,
          "upload": true,
          "download": true,
          "publish": true,
          "public_url_probe": true,
          "unlink": false,
          "cleanup": true
        },
        "capabilities": {
          "file_ops": "supported",
          "public_link_create": "supported",
          "public_link_unlink": "unknown",
          "public_link_expire": "unknown",
          "direct_download_url": "unknown"
        }
      },
      "warnings": [
        "unlink is not confirmed for this backend"
      ]
    }
  ]
}
